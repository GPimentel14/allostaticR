Package: allostaticR
Type: Package
Title: Allostatic Load Estimation and Analysis
Version: 0.1.0
Authors@R: c(
    person("Gumercindo", "Pimentel Peralta", email = "gumercindopimentel@gmail.com",
           role = c("aut", "cre"), comment = c(ORCID = "0000-0002-5896-3171")),
